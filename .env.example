# Supabase — SPEC.md §10, §11.
#
# Both are safe to commit to a private repo and to ship in the bundle: the anon
# key is publishable by design and row-level security is the actual boundary
# (§10). Leave them unset and the app runs local-only, exactly as it did before
# milestone 4.
#
# Project settings → API, in the Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
